NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service-role key (server-side only — never expose to the client).
# Used by admin routes and the error reporter to bypass RLS for admin reads
# and pre-auth error logging. Find in Supabase dashboard → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Comma-separated list of Supabase user UUIDs that should see /admin routes
# and the Admin button in the nav. Find user IDs in Supabase dashboard →
# Auth → Users.
ADMIN_USER_IDS=uuid-1,uuid-2
