# Inkborne backup container — secrets and configuration.
#
# Copy this file to `.env` and fill in real values. Then `chmod 600 .env`.
# The same values should be saved in your password manager — without them
# the encrypted restic repo is unreadable.

# ---- Supabase Postgres ----
# Use the Supavisor pooler in **session mode** (port 5432). The pooler is
# IPv4-friendly (the direct connection `db.<ref>.supabase.co` is IPv6-only
# for new projects without the IPv4 add-on).
#
# Paste the complete Session pooler connection string from Supabase Connect.
# Keep the real URI only in the ignored `.env`; this tracked template uses a
# deliberately non-operational, non-URI marker so scanners and logs cannot
# mistake an example for a credential.
PGURI=REPLACE_WITH_SUPABASE_SESSION_POOLER_CONNECTION_STRING

# ---- Supabase Storage (S3-compatible) ----
# Generate keys in: Supabase dashboard → Storage → Settings → S3 Connection.
SUPABASE_S3_ENDPOINT=https://etcaodglvcspcmwecyxq.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_KEY_ID=REPLACE_ME
SUPABASE_S3_SECRET=REPLACE_ME

# ---- Restic encryption ----
# Long random passphrase. Once the repo is initialized, this cannot be
# rotated without re-encrypting the whole repo. Generate via:
#   openssl rand -base64 32
RESTIC_PASSWORD=REPLACE_ME_LONG_RANDOM

# ---- Discord notifications ----
# Server Settings → Integrations → Webhooks → New Webhook → copy URL.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME

# ---- Optional ----
# Set to 1 to run a backup immediately when the container starts. Useful
# the first time you build the image. Leave at 0 once you've confirmed
# the cron schedule works.
RUN_ON_START=0

# Plaintext dump + Storage staging is mounted as tmpfs. Increase this only if
# the combined uncompressed working set grows beyond 2 GiB.
BACKUP_STAGING_SIZE=2g
